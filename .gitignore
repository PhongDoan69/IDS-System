artifacts/preprocessors/*
artifacts/thresholds/*
!artifacts/preprocessors/.gitkeep
!artifacts/thresholds/.gitkeep

# Giữ JSON/CSV metric nhỏ; bỏ xác suất, novelty score và prediction cỡ lớn.
results/**/*.npy
results/**/*.csv.gz
