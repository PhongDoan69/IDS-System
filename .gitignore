.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Dữ liệu nguồn lớn, giữ tại máy nhưng không commit.
CICIDS2017/*.csv
Tài liệu tham khảo/*.pdf

# Dữ liệu trung gian và model sinh lại được.
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
artifacts/preprocessors/*
artifacts/thresholds/*
!artifacts/preprocessors/.gitkeep
!artifacts/thresholds/.gitkeep

# Publish textual experiment evidence for comparison; keep runtime binaries local.
# Unignore directories so the extension allowlist also works for nested studies.
/results/**/*
!/results/**/
!/results/**/*.json
!/results/**/*.csv
!/results/**/*.md
!/results/**/.gitkeep

# Generated training metadata remains local; stable dataset schema/manifest above
# these phase folders may stay versioned. Existing tracked files are unaffected.
/artifacts/metadata/autoencoder/
/artifacts/metadata/stage1/
/artifacts/metadata/stage2/
/artifacts/metadata/novelty/
/artifacts/external_training.lock

/data/external/
/CSE-CIC-IDS2018/
